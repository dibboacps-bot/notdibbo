
{
  "name": "astro-blog-starter-template",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "VIDEO_UPLOADS": "owner",
    "MAX_VIDEO_MB": "500",
    "USER_QUOTA_MB": "2048"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notdibbo-db",
      "database_id": "e36cf8b4-e3b8-4c11-8f2f-637dd1568681",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "notdibbo-media"
    }
  ]
}
