<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#050b18" />
  <meta name="description" content="Welcome to NOTDIBBO Gaming. Minecraft, GTA and more!" />
  <title>NOTDIBBO | Gaming Universe</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: #050b18;
      color: #f4f8ff;
      font-family: Arial, Helvetica, sans-serif;
    }
    a { color: inherit; text-decoration: none; }
    header {
      position: sticky; top: 0; z-index: 10;
      display: flex; justify-content: space-between;
      align-items: center; padding: 20px 8%;
      background: rgba(5,11,24,.94);
      border-bottom: 1px solid #15345c;
      backdrop-filter: blur(12px);
    }
    .logo { font-size: 25px; font-weight: 900; letter-spacing: 2px; }
    .logo span { color: #00baff; }
    nav { display: flex; gap: 25px; }
    nav a { color: #b9c9e0; font-size: 14px; }
    nav a:hover { color: #00c8ff; }
    .hero {
      min-height: 590px; padding: 110px 8%;
      display: flex; flex-direction: column;
      justify-content: center; align-items: flex-start;
      background:
        radial-gradient(ellipse at 80% 45%, #073e76 0%, transparent 48%),
        linear-gradient(120deg,#050b18,#091b35);
      border-bottom: 1px solid #123b67;
    }
    .tag {
      color: #00c8ff; border: 1px solid #007db5;
      padding: 9px 16px; border-radius: 30px;
      font-size: 12px; letter-spacing: 2px;
      margin-bottom: 25px;
    }
    h1 { font-size: clamp(48px, 9vw, 88px); line-height: 1.05; }
    h1 span { color: #00baff; text-shadow: 0 0 30px #007eff; }
    .hero p { color: #a9bdd8; max-width: 550px; line-height: 1.8; margin: 25px 0 30px; }
    .btn {
      display: inline-block; padding: 15px 27px;
      background: #008dff; border-radius: 7px;
      font-weight: bold; box-shadow: 0 0 25px #007eff55;
      transition: .2s;
    }
    .btn:hover { background: #00c8ff; transform: translateY(-3px); }
    .btn.secondary { background: transparent; border: 1px solid #168bdb; margin-left: 10px; }
    section { padding: 85px 8%; }
    .heading { font-size: 34px; margin-bottom: 15px; }
    .heading span { color: #00baff; }
    .sub { color: #8fa6c5; margin-bottom: 35px; line-height: 1.7; }
    .about {
      background: #081326; border: 1px solid #16395e;
      padding: 30px; border-radius: 14px;
      color: #b4c6df; line-height: 1.9;
      max-width: 850px;
    }
    .cards {
      display: grid; grid-template-columns: repeat(3,1fr);
      gap: 22px;
    }
    .card {
      background: linear-gradient(145deg,#102440,#081326);
      border: 1px solid #19436d; border-radius: 13px;
      padding: 28px; transition: .25s;
    }
    .card:hover {
      transform: translateY(-7px);
      border-color: #00baff;
      box-shadow: 0 0 25px #008cff22;
    }
    .emoji { font-size: 43px; margin-bottom: 17px; }
    .card h3 { font-size: 21px; margin-bottom: 12px; }
    .card p { color: #9bb0cc; line-height: 1.7; font-size: 14px; }
    .social { display: flex; flex-wrap: wrap; gap: 14px; }
    footer {
      text-align: center; padding: 30px 15px;
      background: #030812; color: #8196b4;
      border-top: 1px solid #15345c;
      font-size: 13px; line-height: 2;
    }
    footer strong { color: #00baff; }
    @media(max-width:700px) {
      header { padding: 17px 5%; flex-wrap: wrap; gap: 15px; }
      nav { gap: 14px; flex-wrap: wrap; }
      nav a { font-size: 12px; }
      .hero { padding: 90px 6%; min-height: 530px; }
      section { padding: 65px 6%; }
      .cards { grid-template-columns: 1fr; }
      .btn.secondary { margin-left: 0; margin-top: 12px; }
    }
     .video-box {
  width: 100%;
  max-width: 750px;
  aspect-ratio: 16 / 9;
  margin: 25px auto;
}

.video-box iframe {
  width: 100%;
  height: 100%;
  border: 2px solid #00d9ff;
  border-radius: 14px;
}
.neon-button {
  display: inline-block;
  padding: 14px 25px;
  color: #00eaff;
  border: 2px solid #00eaff;
  border-radius: 10px;
  text-decoration: none;
  transition: 0.3s ease;
}

.neon-button:hover {
  background: #00eaff;
  color: #06101e;
  box-shadow: 0 0 12px #00eaff, 0 0 30px #0077ff;
  transform: translateY(-4px);
}
.cursor-glow {
  position: fixed;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #00eaff;
  box-shadow: 0 0 12px #00eaff, 0 0 28px #0077ff;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
  left: 0;
  top: 0;
  opacity: 0;
  transition: opacity 0.2s;
}

@media (hover: hover) and (pointer: fine) {
  body:hover .cursor-glow {
    opacity: 1;
  }
}

@media (hover: none) {
  .cursor-glow {
    display: none;
  }
}
.gaming-gif {
  width: 100%;
  max-width: 600px;
  border-radius: 15px;
  box-shadow: 0 0 20px #00d9ff;
}
/* Hide the normal mouse cursor on the website */
* {
  cursor: none !important;
}

/* Custom neon cursor */
.cursor-glow {
  position: fixed;
  top: 0;
  left: 0;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #00eaff;
  box-shadow:
    0 0 10px #00eaff,
    0 0 25px #008cff,
    0 0 45px #0077ff;
  pointer-events: none;
  z-index: 99999;
  transform: translate(-50%, -50%);
}

/* Hide custom cursor on touchscreens */
@media (hover: none), (pointer: coarse) {
  * {
    cursor: auto !important;
  }

  .cursor-glow {
    display: none;
  }
}
@keyframes floating {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12px);
  }
}

h1 {
  animation: floating 3s ease-in-out infinite;
}
/* Hide normal cursor on desktop */
@media (hover: hover) and (pointer: fine) {
  * {
    cursor: none !important;
  }

  .cursor-ring {
    position: fixed;
    width: 34px;
    height: 34px;
    border: 2px solid #00eaff;
    border-radius: 50%;
    pointer-events: none;
    z-index: 999999;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 10px #00eaff, 0 0 22px #0077ff;
  }

  .cursor-dot {
    position: absolute;
    width: 7px;
    height: 7px;
    background: #00eaff;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 10px #00eaff;
  }
}

@media (hover: none), (pointer: coarse) {
  .cursor-ring {
    display: none;
  }
}
  </style>
</head>
